<Application x:Class="ClaudeStats.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ClaudeStats"
             xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
             xmlns:views="clr-namespace:ClaudeStats.Views"
             xmlns:conv="clr-namespace:ClaudeStats.Views.Converters"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <conv:PathToImageSourceConverter x:Key="PathToIcon" />
        <tb:TaskbarIcon x:Key="TrayIcon"
                        IconSource="{Binding IconResourcePath, Converter={StaticResource PathToIcon}}"
                        ToolTipText="{Binding StatusText}"
                        NoLeftClickDelay="True">
            <tb:TaskbarIcon.TrayPopup>
                <views:TrayPopupView />
            </tb:TaskbarIcon.TrayPopup>
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Refresh" Command="{Binding RefreshCommand}" />
                    <MenuItem Header="Usage stats…" Command="{Binding ShowTrendCommand}" />
                    <MenuItem Header="Settings…" Command="{Binding ShowSettingsCommand}" />
                    <Separator />
                    <MenuItem Header="Exit" Command="{Binding ExitCommand}" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
    </Application.Resources>
</Application>
