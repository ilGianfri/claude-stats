<Window x:Class="ClaudeStats.Views.TrendWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:ClaudeStats.Views.Converters"
        mc:Ignorable="d"
        Title="Claude Usage — Last 30 Days"
        Height="380" Width="680"
        WindowStartupLocation="CenterScreen"
        Background="#FF1B1D22">
    <Window.Resources>
        <conv:FractionToHeightConverter x:Key="FracToHeight" />
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="USAGE STATISTICS" Foreground="#99FFFFFF"
                   FontSize="12" FontWeight="SemiBold" />

        <!-- Totals row -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,16">
            <StackPanel Margin="0,0,32,0">
                <TextBlock Text="{Binding TotalTokensText}" Foreground="White" FontSize="24" FontWeight="Bold" />
                <TextBlock Text="tokens" Foreground="#80FFFFFF" FontSize="11" />
            </StackPanel>
            <StackPanel Margin="0,0,32,0">
                <TextBlock Text="{Binding TotalMessagesText}" Foreground="White" FontSize="24" FontWeight="Bold" />
                <TextBlock Text="messages" Foreground="#80FFFFFF" FontSize="11" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="{Binding TotalCostText}" Foreground="White" FontSize="24" FontWeight="Bold" />
                <TextBlock Text="est. cost" Foreground="#80FFFFFF" FontSize="11" />
            </StackPanel>
        </StackPanel>

        <!-- Chart -->
        <Border Grid.Row="2" Background="#22000000" CornerRadius="8" Padding="12">
            <ItemsControl ItemsSource="{Binding Bars}" VerticalAlignment="Bottom">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Width="18" Height="160" Margin="1,0" VerticalAlignment="Bottom"
                              ToolTip="{Binding Tooltip}">
                            <Rectangle Width="14" VerticalAlignment="Bottom" Fill="#FF4A9EE0"
                                       RadiusX="2" RadiusY="2"
                                       Height="{Binding Fraction, Converter={StaticResource FracToHeight}, ConverterParameter=150}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <TextBlock Grid.Row="3" Text="{Binding StatusText}" Foreground="#99FFFFFF"
                   FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap" />
    </Grid>
</Window>
